DATABASE_URL=postgresql://unihub_retail_app:change_me@127.0.0.1:5433/unihub_retail
JWT_SECRET=change_me_to_a_random_string_at_least_32_chars
JWT_EXPIRE_HOURS=24
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=9999
DEFAULT_MANAGEMENT_USERNAME=management
DEFAULT_MANAGEMENT_PASSWORD=9999

UNIHUB_HUB_SPECIALS_CONFIG=data/hub_specials.json
UNIHUB_INCENTIVE_FILE=data/Coduri incentive.xlsx

RESET_DEFAULT_USERS_ON_BOOT=false
SYNC_TL_ASSIGNMENTS_ON_BOOT=false
DB_POOL_MAX_SIZE=10

VISITS_DB_PATH=/opt/Mobiup/unihub/data/visits/visits.db
VISITS_IMAGES_DIR=/opt/Mobiup/unihub/data/visits/images

# Environment flag — "development" (default) sau "production".
# În "production" backend-ul refuză startup dacă admin/management au încă parola default.
UNIHUB_ENV=development
# UNIHUB_ALLOW_DEFAULT_PASSWORDS=1   # DOAR pentru bootstrap inițial în prod

# Background job queue (arq + Valkey)
VALKEY_URL=redis://localhost:6379
OIDC_CLIENT_SECRET=CHANGE_ME
# Email-uri OIDC autorizate sa publice targetul final (comma-separated).
TARGET_CALCULATOR_FINALIZER_EMAILS=aner.valens@gmail.com
