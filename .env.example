DATABASE_URL=postgresql://unihub:change_me@127.0.0.1:5432/unihub
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

UNIHUB_HUB_SPECIALS_CONFIG=data/hub_specials.json
UNIHUB_INCENTIVE_FILE=data/Coduri incentive.xlsx

SYNC_TL_ASSIGNMENTS_ON_BOOT=false
DB_POOL_MAX_SIZE=10

VISITS_DB_PATH=/opt/Mobiup/unihub/data/visits/visits.db
VISITS_IMAGES_DIR=/opt/Mobiup/unihub/data/visits/images

# Environment flag — "development" (default) sau "production".
UNIHUB_ENV=development
MAX_SALES_UPLOAD_BYTES=33554432

# Background job queue (arq + Valkey)
VALKEY_URL=redis://localhost:6379

# Targete agent din Grile. Default-ul operational este conservator:
# doar managerii activati primesc override-uri in agent_targets; zonele excluse
# raman pe fallback-ul target locatie / agenti activi.
GRILE_AGENT_TARGET_ENABLED_MANAGERS=Andrei Stancu,Adrian Badea,Mihai Condorateanu,Elena Minca
GRILE_AGENT_TARGET_DISABLED_MANAGERS=Bogdan Radu,Bogdana Costan

OIDC_CLIENT_SECRET=CHANGE_ME
# Email-uri OIDC autorizate sa publice targetul final (comma-separated).
TARGET_CALCULATOR_FINALIZER_EMAILS=aner.valens@gmail.com
