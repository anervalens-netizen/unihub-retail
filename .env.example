DATABASE_URL=postgresql://unihub:change_me@127.0.0.1:5432/unihub
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

UNIHUB_HUB_SPECIALS_CONFIG=data/hub_specials.json
UNIHUB_INCENTIVE_FILE=data/Coduri incentive.xlsx

SYNC_TL_ASSIGNMENTS_ON_BOOT=false
DB_POOL_MAX_SIZE=10
DB_STATEMENT_TIMEOUT_MS=120000
DB_LOCK_TIMEOUT_MS=10000
DB_IDLE_TRANSACTION_TIMEOUT_MS=60000
# Bounded backend ERROR persistence. Invalid values are clamped safely.
DB_ERROR_LOG_QUEUE_SIZE=256
DB_ERROR_LOG_WRITE_TIMEOUT_SECONDS=2.0
DB_ERROR_LOG_DRAIN_TIMEOUT_SECONDS=2.0

VISITS_DB_PATH=/opt/Mobiup/unihub/data/visits/visits.db
VISITS_IMAGES_DIR=/opt/Mobiup/unihub/data/visits/images

# Environment flag — "development" (default) sau "production".
UNIHUB_ENV=development
MAX_SALES_UPLOAD_BYTES=33554432

# Background job queue (arq + Valkey)
VALKEY_URL=redis://localhost:6379

# Targete agent din Grile. Default-ul operational este conservator:
# doar managerii activati primesc override-uri in agent_targets; zonele excluse
# raman pe fallback-ul target locatie / agenti activi.
GRILE_AGENT_TARGET_ENABLED_MANAGERS=Manager Exemplu 1,Manager Exemplu 2
GRILE_AGENT_TARGET_DISABLED_MANAGERS=Manager Exclus Exemplu

OIDC_CLIENT_SECRET=CHANGE_ME
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_AUDIENCE=
JWKS_CACHE_TTL=3600
JWKS_MAX_STALE_SECONDS=86400
JWKS_FETCH_TIMEOUT_SECONDS=5.0
OIDC_CLOCK_SKEW_SECONDS=30
JWKS_UNKNOWN_KID_REFRESH_COOLDOWN_SECONDS=5.0
JWKS_REFRESH_FAILURE_RETRY_SECONDS=5.0
TRUSTED_PROXY_CIDRS=
RATE_LIMIT_CLIENT_IP_HEADER=none
RATE_LIMIT_VALKEY_URL=
RATE_LIMIT_KEY_HMAC_SECRET=
RATE_LIMIT_FAILURE_MODE=closed
RATE_LIMIT_AUTH_PROXY=120
RATE_LIMIT_AUTH_PROXY_WINDOW_SECONDS=60
RATE_LIMIT_SALES_IMPORT_UPLOAD=5
RATE_LIMIT_SALES_IMPORT_UPLOAD_WINDOW_SECONDS=900
RATE_LIMIT_REPORT_EXPORT=30
RATE_LIMIT_REPORT_EXPORT_WINDOW_SECONDS=60
RATE_LIMIT_BUSINESS_WRITE=60
RATE_LIMIT_BUSINESS_WRITE_WINDOW_SECONDS=60
RATE_LIMIT_GRILE_JOB=10
RATE_LIMIT_GRILE_JOB_WINDOW_SECONDS=300
RATE_LIMIT_TARGET_MUTATION=30
RATE_LIMIT_TARGET_MUTATION_WINDOW_SECONDS=300
# Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SALARY_PERSON_ID_HMAC_KEY=
# Dedicated OIDC groups for high-impact operations.
TARGET_CALCULATOR_FINALIZER_GROUPS=unihub-target-finalizer
GRILE_FINALIZER_GROUPS=unihub-grile-admin
STORE_PNL_ACCESS_GROUPS=unihub-pnl-owner
