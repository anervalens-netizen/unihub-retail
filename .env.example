DATABASE_URL=postgresql://unihub:change_me@localhost:5432/unihub
JWT_SECRET=change_me_to_a_random_string_at_least_32_chars
JWT_EXPIRE_HOURS=24
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=9999
DEFAULT_MANAGEMENT_USERNAME=management
DEFAULT_MANAGEMENT_PASSWORD=9999

UNIHUB_HUB_SPECIALS_CONFIG=data/hub_specials.json
UNIHUB_INCENTIVE_FILE=data/Coduri incentive.xlsx

RESET_DEFAULT_USERS_ON_BOOT=false
SYNC_TL_ASSIGNMENTS_ON_BOOT=false
DB_POOL_MAX_SIZE=10

AI_BRIDGE_URL=http://127.0.0.1:7777
AI_BRIDGE_TIMEOUT=180
VISITS_DB_PATH=/opt/Mobiup/Platforma-Mobiup/db/visit_reports.db
VISITS_IMAGES_DIR=/opt/Mobiup/Platforma-Mobiup/local-data/visit-reports/images
