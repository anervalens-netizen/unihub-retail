{
  "version": 2,
  "description": "Minimal high-risk paths manifest for A3 governance v2. Deterministic matching only: exact (changed_path == entry) or prefix (entry ends with '/' and changed_path.startswith(entry)). No glob, no fnmatch, no '**'.",
  "match_rules": {
    "exact": "changed_path == entry",
    "prefix": "entry ends with '/' AND changed_path.startswith(entry)"
  },
  "categories": {
    "auth-identity": {
      "description": "Production auth/OIDC, session, permissions, privileged access, receipt/private identity. Operational scripts included. No tests.",
      "paths": [
        "backend/auth.py",
        "backend/oidc_settings.py",
        "backend/oidc_verifier.py",
        "backend/session_auth.py",
        "backend/session_runtime_helpers.py",
        "backend/session_settings.py",
        "backend/permissions.py",
        "backend/privileged_access.py",
        "backend/services/receipt_identity.py",
        "backend/scripts/oidc_e2e_stub.py",
        "backend/scripts/reconcile_return_receipt_identity.sql"
      ]
    },
    "migrations-db-authority": {
      "description": "Catches FUTURE migrations via directory prefix. Migration runner authority included. Generic DB plumbing excluded.",
      "paths": [
        "backend/db/migrations/",
        "backend/db/migration_runner.py"
      ]
    },
    "deploy-release-ci": {
      "description": "Delivery/control plane only: workflows, governance, the checker itself, deployment/release/rollback/provisioning, production systemd/Caddy/env-schema, plus the B3/E2 selector/control-plane trust surface (PR-B3a selector, PR-B3b coverage + isolated-test runner + bootstrap-test-DB, backend test authority conftest). No routine README, Dependabot, generic observability.",
      "paths": [
        ".github/workflows/",
        ".github/governance/",
        "scripts/check_high_risk_pr_governance.py",
        "scripts/pr_merge_gate.py",
        "scripts/is_high_risk_category_touched.py",
        "scripts/check_python_complexity_contract.py",
        "scripts/_python_complexity.py",
        "scripts/python-complexity-contract-v2.json",
        "scripts/check_changed_function_complexity.py",
        "scripts/check_changed_line_coverage.py",
        "scripts/check_complexity_ratchet.py",
        "scripts/complexity-ratchet.json",
        "scripts/create_production_release_tag.py",
        "ops/approve-retail-release.sh",
        "ops/build-retail-release-artifact.sh",
        "ops/deploy-retail-artifact.sh",
        "ops/test-deploy-retail-artifact.sh",
        "ops/provision-retail-service-identities.sh",
        "ops/provision-retail-salary-export-database.sh",
        "ops/caddy/",
        "ops/config/retail-env.schema.json",
        "ops/systemd/",
        "scripts/pr_fast_select_tests.py",
        "scripts/pr_b3b_selected_paths_validator.py",
        "scripts/pr_b3b_decide_policy.py",
        "scripts/pr_b3b_publish_policy_status.py",
        "scripts/pr_b3b_compose_certification.py",
        ".coveragerc",
        "backend/scripts/run_tests_isolated.sh",
        "backend/scripts/bootstrap_test_db.py",
        "backend/scripts/check_critical_coverage.py",
        "backend/critical_coverage_thresholds.json",
        "backend/conftest.py",
        "backend/tests/conftest.py"
      ]
    },
    "salary-private-identity": {
      "description": "Production salary/private-identity implementation. No tests. Old salary migrations are governed by migrations-db-authority (no duplication).",
      "paths": [
        "backend/salary_identity.py",
        "backend/salary_import_approval.py",
        "backend/salary_import_persistence.py",
        "backend/services/asm_salary.py",
        "backend/services/salary_exports.py",
        "backend/services/salarii.py",
        "backend/repositories/salarii.py",
        "backend/repositories/salarii_detail.py",
        "backend/repositories/salarii_scope.py",
        "backend/repositories/salarii_summary.py",
        "backend/routers/salarii.py",
        "backend/schemas/salarii.py",
        "backend/scripts/backfill_salary_private_identities.py",
        "backend/scripts/import_salary_records.py",
        "backend/scripts/match_agent_codes_to_salary_names.py",
        "backend/scripts/reconcile_salary_person_ids.py"
      ]
    },
    "target-calculator": {
      "description": "Target calculator authority: backend service (prefix), repository (facade + extracted mixins), router, frontend API, frontend features (prefix). No tests.",
      "paths": [
        "backend/services/target_calculator/",
        "backend/repositories/target_calculator.py",
        "backend/repositories/target_calculator_sources.py",
        "backend/repositories/target_calculator_scenarios.py",
        "backend/repositories/target_calculator_detail.py",
        "backend/routers/target_calculator.py",
        "src/api/targetCalculator.ts",
        "src/features/target-calculator/"
      ]
    }
  }
}
