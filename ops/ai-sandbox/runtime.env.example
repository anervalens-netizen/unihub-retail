# UniHub Retail private AI runtime.
# Install as /opt/Mobiup/unihub-retail/.env.ai with mode 0600.
# Never expose this file to the browser or mount it into the model sandbox.

OPENAI_API_KEY=
# IMPORTANT: this host must be reachable from the Docker sandbox. Do not use
# 127.0.0.1/localhost: inside the sandbox those addresses point back to the
# sandbox container itself. Production chooses one reviewed bridge-reachable
# PostgreSQL endpoint for the dedicated read-only login.
#
# The login named here must be a dedicated LOGIN principal whose entire
# authority comes from the repository read-only role `unihub_web_read`:
#   CREATE ROLE unihub_ai_readonly LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE
#     NOREPLICATION NOBYPASSRLS INHERIT PASSWORD '...';
#   GRANT unihub_web_read TO unihub_ai_readonly;
# Do not reuse the web, worker or business-write DSN: the runtime connects with
# this exact credential at startup and refuses to report healthy unless the
# principal has no elevated role attribute, no other effective membership, no
# effective INSERT/UPDATE/DELETE/TRUNCATE on application tables, no CREATE on
# application schemas or the database, and bounded session defaults.
#
# Bounded PostgreSQL defaults are mandatory on the role so that arbitrary
# psql/Python clients inside the sandbox inherit them too (maximum permitted):
#   ALTER ROLE unihub_ai_readonly SET statement_timeout = '120s';
#   ALTER ROLE unihub_ai_readonly SET lock_timeout = '5s';
#   ALTER ROLE unihub_ai_readonly SET idle_in_transaction_session_timeout = '60s';
# statement_timeout must stay <= 300000 ms, lock_timeout <= 5000 ms (and below
# statement_timeout) and idle_in_transaction_session_timeout <= 60000 ms.
# These USERSET defaults are defense in depth, not an external ceiling.
# The host runtime also connects using this SAME login (no pg_signal_backend or
# privileged credential), application_name=unihub-ai-db-guard. Once per second
# it cancels this login's active statements >300s / lock-wait queries >5s and
# terminates idle transactions >60s, even after SET timeout=0. Lock elapsed uses
# query_start conservatively; enforcement has polling/scan latency, not exact
# millisecond precision. Other PostgreSQL roles are never targeted.
# Readiness requires exact-label Docker orphan cleanup, authority verification,
# and the first successful guard scan. Guard disconnects reject NEW runs with
# 503 until reconnect/scan succeeds (1..5s backoff); active model tasks continue.
AI_ASSISTANT_READONLY_DSN=postgresql://unihub_ai_readonly:change_me@db-host-reachable-from-sandbox:5432/unihub
# Loopback URL of this runtime. The web backend reads the same variable to
# reach the runtime; the default matches the systemd ExecStart bind address.
AI_ASSISTANT_RUNTIME_URL=http://127.0.0.1:9911
AI_ASSISTANT_SANDBOX_IMAGE=unihub-retail-ai-sandbox:v3-dev
AI_ASSISTANT_STORAGE_ROOT=/var/lib/unihub-retail/ai-assistant
AI_ASSISTANT_SNAPSHOT_ROOT=/var/lib/unihub-retail/ai-assistant/snapshots
AI_ASSISTANT_MAX_ARTIFACT_BYTES=268435456
# Total changed output bytes per collection, not conversation/lifetime storage.
# Must be >= the individual limit. Metadata is checked before payload transfer;
# sequential collection rechecks actual bytes and rolls back on failure/cancellation.
AI_ASSISTANT_MAX_TOTAL_ARTIFACT_BYTES=1073741824
AI_ASSISTANT_SETUP_TIMEOUT_SECONDS=90
# Capability-first bound on simultaneous Docker/model runs per authenticated
# owner. It bounds spend only; an accepted run keeps unlimited internal turns.
AI_ASSISTANT_MAX_CONCURRENT_RUNS_PER_OWNER=2
