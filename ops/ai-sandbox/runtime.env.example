# UniHub Retail private AI runtime.
# Install as /opt/Mobiup/unihub-retail/.env.ai with mode 0600.
# Never expose this file to the browser or mount it into the model sandbox.

OPENAI_API_KEY=
# IMPORTANT: this host must be reachable from the Docker sandbox. Do not use
# 127.0.0.1/localhost: inside the sandbox those addresses point back to the
# sandbox container itself. Production chooses one reviewed bridge-reachable
# PostgreSQL endpoint for the dedicated read-only login.
AI_ASSISTANT_READONLY_DSN=postgresql://unihub_ai_readonly:change_me@db-host-reachable-from-sandbox:5432/unihub
AI_ASSISTANT_SANDBOX_IMAGE=unihub-retail-ai-sandbox:v3-dev
AI_ASSISTANT_STORAGE_ROOT=/var/lib/unihub-retail/ai-assistant
AI_ASSISTANT_SNAPSHOT_ROOT=/var/lib/unihub-retail/ai-assistant/snapshots
AI_ASSISTANT_MAX_ARTIFACT_BYTES=268435456
AI_ASSISTANT_SETUP_TIMEOUT_SECONDS=90
