{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retail.unihub.ro/schemas/environment-v1.json",
  "title": "UniHub Retail environment",
  "type": "object",
  "additionalProperties": false,
  "x-dotenv-parser": "python-dotenv",
  "x-precedence": ["process environment", "dotenv file", "code default"],
  "x-process-profiles": {
    "web": ["DATABASE_URL", "UNIHUB_DB_PROCESS_AUTHORITY", "UNIHUB_ENV"],
    "operations-worker": ["DATABASE_URL", "UNIHUB_DB_PROCESS_AUTHORITY", "RETAIL_WORKER_ROLE", "VALKEY_URL"],
    "import-worker": ["DATABASE_URL", "UNIHUB_DB_PROCESS_AUTHORITY", "RETAIL_WORKER_ROLE", "VALKEY_URL"],
    "migration": ["MIGRATION_DATABASE_URL", "UNIHUB_DB_PROCESS_AUTHORITY"],
    "frontend-build": ["VITE_API_BASE_URL", "VITE_FRONTEND_GLITCHTIP_DSN"]
  },
  "properties": {
    "BACKEND_SENTRY_DSN": {"type": "string"},
    "BACKEND_SENTRY_TRACES_SAMPLE_RATE": {"type": "string", "pattern": "^(0(?:\\.\\d+)?|1(?:\\.0+)?)$"},
    "CAMPAIGNS_REQUEST_DEADLINE_MS": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "CAMPAIGN_REPORTING_DATABASE_URL": {"type": "string", "pattern": "^postgres(?:ql)?://", "x-process-only": true},
    "CORS_ORIGINS": {"type": "string"},
    "DATABASE_URL": {"type": "string", "pattern": "^postgres(?:ql)?://"},
    "DASHBOARD_GLOBAL_COMPONENT_CONCURRENCY": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "DB_ERROR_LOG_DRAIN_TIMEOUT_SECONDS": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
    "DB_ERROR_LOG_QUEUE_SIZE": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "DB_ERROR_LOG_WRITE_TIMEOUT_SECONDS": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
    "DB_IDLE_TRANSACTION_TIMEOUT_MS": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "DB_LOCK_TIMEOUT_MS": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "DB_POOL_MAX_SIZE": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "DB_POOL_MIN_SIZE": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "DB_STATEMENT_TIMEOUT_MS": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "DISABLE_HMR": {"type": "string", "enum": ["true", "false"], "x-ephemeral": true},
    "EXPORT_ARTIFACT_DIR": {"type": "string", "x-ephemeral": true},
    "EXPORT_RENDERER_TIMEOUT_SECONDS": {"type": "string", "pattern": "^[1-9][0-9]*$", "x-process-only": true},
    "FINANCE_PNL_DATABASE_URL": {"type": "string", "pattern": "^postgres(?:ql)?://", "x-process-only": true},
    "GRILE_AGENT_TARGET_DISABLED_MANAGERS": {"type": "string"},
    "GRILE_AGENT_TARGET_ENABLED_MANAGERS": {"type": "string"},
    "GRILE_FINALIZER_GROUPS": {"type": "string"},
    "GRILE_GOOGLE_HTTP_TIMEOUT_SECONDS": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "GRILE_GOOGLE_SA_FILE": {"type": "string", "x-sensitive": true},
    "GRILE_OUTPUTS_DIR": {"type": "string", "x-process-only": true},
    "GRILE_PROVIDER_STALE_AFTER_SECONDS": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "GRILE_TARGET_SYNC_GROUPS": {"type": "string"},
    "JWKS_CACHE_TTL": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "JWKS_FETCH_TIMEOUT_SECONDS": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
    "JWKS_MAX_STALE_SECONDS": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "JWKS_REFRESH_FAILURE_RETRY_SECONDS": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
    "JWKS_UNKNOWN_KID_REFRESH_COOLDOWN_SECONDS": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
    "HUB_INTERNAL_SECRET": {"type": "string", "x-sensitive": true},
    "LOG_FORMAT": {"type": "string", "enum": ["text", "json"], "x-process-only": true},
    "MAX_ERP_RECONCILIATION_UPLOAD_BYTES": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "MAX_HTTP_JSON_BODY_BYTES": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "MAX_HTTP_MULTIPART_OVERHEAD_BYTES": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "MAX_PROMO_REPORT_UPLOAD_BYTES": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "MAX_SALES_UPLOAD_BYTES": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "MIGRATION_DATABASE_URL": {"type": "string", "pattern": "^postgres(?:ql)?://unihub_migration_runner:"},
    "OIDC_AUDIENCE": {"type": "string"},
    "OIDC_CLIENT_ID": {"type": "string"},
    "OIDC_CLIENT_SECRET": {"type": "string", "x-sensitive": true},
    "OIDC_CLOCK_SKEW_SECONDS": {"type": "string", "pattern": "^[0-9]+$"},
    "OIDC_ISSUER": {"type": "string"},
    "OIDC_JWKS_URL": {"type": "string"},
    "PROMETHEUS_MULTIPROC_DIR": {"type": "string", "x-process-only": true},
    "REAL_E2E_BASE_URL": {"type": "string", "x-ephemeral": true},
    "REAL_E2E_OIDC_ORIGIN": {"type": "string", "x-ephemeral": true},
    "RATE_LIMIT_AUTH_PROXY": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "RATE_LIMIT_AUTH_PROXY_WINDOW_SECONDS": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "RATE_LIMIT_BUSINESS_WRITE": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "RATE_LIMIT_BUSINESS_WRITE_WINDOW_SECONDS": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "RATE_LIMIT_CLIENT_IP_HEADER": {"type": "string"},
    "RATE_LIMIT_FAILURE_MODE": {"type": "string", "enum": ["", "open", "closed"]},
    "RATE_LIMIT_GRILE_JOB": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "RATE_LIMIT_GRILE_JOB_WINDOW_SECONDS": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "RATE_LIMIT_KEY_HMAC_SECRET": {"type": "string", "x-sensitive": true},
    "RATE_LIMIT_REPORT_EXPORT": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "RATE_LIMIT_REPORT_EXPORT_WINDOW_SECONDS": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "RATE_LIMIT_SALES_IMPORT_UPLOAD": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "RATE_LIMIT_SALES_IMPORT_UPLOAD_WINDOW_SECONDS": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "RATE_LIMIT_TARGET_MUTATION": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "RATE_LIMIT_TARGET_MUTATION_WINDOW_SECONDS": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "RATE_LIMIT_VALKEY_URL": {"type": "string"},
    "RUNTIME_DATABASE_URL": {"type": "string", "pattern": "^postgres(?:ql)?://", "x-provisioning-only": true},
    "SALES_IMPORT_SPOOL_DIR": {"type": "string", "x-process-only": true},
    "SALES_IMPORT_SPOOL_MAX_AGE_SECONDS": {"type": "string", "pattern": "^[1-9][0-9]*$", "x-process-only": true},
    "RETAIL_VISITS_READ_SOURCE": {"type": "string", "enum": ["postgres"]},
    "RETAIL_VISITS_SHADOW_COMPARE_ENABLED": {"type": "string", "enum": ["false"]},
    "SALARY_PERSON_ID_HMAC_KEY": {"type": "string", "x-sensitive": true},
    "SENTRY_DSN": {"type": "string", "x-backend-only": true},
    "SENTRY_TRACES_SAMPLE_RATE": {"type": "string", "pattern": "^(0(?:\\.\\d+)?|1(?:\\.0+)?)$"},
    "SESSION_ENCRYPTION_KEY": {"type": "string", "x-sensitive": true},
    "SESSION_PUBLIC_ORIGIN": {"type": "string"},
    "SESSION_TTL_SECONDS": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "SESSION_VALKEY_URL": {"type": "string", "x-sensitive": true},
    "STORE_PNL_ACCESS_GROUPS": {"type": "string"},
    "TARGET_CALCULATOR_FINALIZER_GROUPS": {"type": "string"},
    "TRUSTED_PROXY_CIDRS": {"type": "string"},
    "UNIHUB_ENV": {"type": "string", "enum": ["development", "production"]},
    "UNIHUB_CONTESTS_CONFIG": {"type": "string", "x-process-only": true},
    "UNIHUB_DATA_DIR": {"type": "string", "x-process-only": true},
    "UNIHUB_HUB_SPECIALS_CONFIG": {"type": "string"},
    "UNIHUB_INCENTIVE_FILE": {"type": "string"},
    "UNIHUB_API_URL": {"type": "string", "x-process-only": true},
    "UNIHUB_PERF_COPY_DATABASE": {"type": "string", "x-ephemeral": true},
    "UNIHUB_RUNNING_TESTS": {"type": "string", "enum": ["0", "1"], "x-ephemeral": true},
    "UNIHUB_RUNTIME_SHA": {"type": "string", "pattern": "^[0-9a-f]{40}$", "x-ephemeral": true},
    "UNIHUB_SMOKE_TOKEN": {"type": "string", "x-sensitive": true},
    "UNIHUB_TEST_DATABASE": {"type": "string", "enum": ["0", "1"], "x-ephemeral": true},
    "TIMESFM_API_KEY": {"type": "string", "x-sensitive": true},
    "VALKEY_HOST": {"type": "string", "x-process-only": true},
    "VALKEY_PASSWORD": {"type": "string", "x-sensitive": true},
    "VALKEY_URL": {"type": "string"},
    "VISITS_DB_PATH": {"type": "string"},
    "VISITS_IMAGES_DIR": {"type": "string"},
    "VITE_API_BASE_URL": {"type": "string", "pattern": "^/(?!/)"},
    "VITE_FRONTEND_GLITCHTIP_DSN": {"type": "string"},
    "VITE_PROXY_TARGET": {"type": "string", "x-ephemeral": true},
    "WORKER_METRICS_HOST": {"type": "string", "x-process-only": true},
    "WORKER_METRICS_PORT": {"type": "string", "pattern": "^[1-9][0-9]*$", "x-process-only": true},
    "UNIHUB_DB_PROCESS_AUTHORITY": {"type": "string", "enum": ["web", "operations", "sales_import", "finance_import", "migrate"]},
    "RETAIL_WORKER_ROLE": {"type": "string", "enum": ["operations", "imports", "grile", "exports"]}
  }
}
