# Generated contract profile: web. systemd owns process authority.
DATABASE_URL=postgresql://unihub_web:change_me@127.0.0.1:5432/unihub # pragma: allowlist secret
UNIHUB_DB_PROCESS_AUTHORITY=web
UNIHUB_ENV=production
# Prometheus scrape peer allow-list for backend/main.py:/metrics.
PROMETHEUS_DOCKER_GATEWAY=
PROMETHEUS_DOCKER_SUBNET=
# Effective-dated VAT toggle consumed by services/fiscal_rules.py.
EFFECTIVE_DATED_VAT_ENABLED=
