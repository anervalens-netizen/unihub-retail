[Unit]
Description=UniHub Retail database migration runner
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=unihub-migrate
Group=unihub-migrate
WorkingDirectory=/opt/Mobiup/unihub-retail/backend
EnvironmentFile=/opt/Mobiup/unihub-retail/.env.migrations
Environment="UNIHUB_DB_PROCESS_AUTHORITY=migrate"
Environment="PYTHONDONTWRITEBYTECODE=1"
ExecStart=/opt/Mobiup/unihub-retail/backend/venv/bin/python scripts/run_migrations.py
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal
SyslogIdentifier=unihub-retail-migrate
ProtectSystem=strict
InaccessiblePaths=-/opt/Mobiup/unihub-retail/data/export_artifacts/salary
ProtectHome=read-only
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0077
