[Unit]
Description=UniHub Retail isolated export worker (arq)
After=network-online.target docker.service mobiup-dwh-postgres.service
Wants=network-online.target docker.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=andrei
WorkingDirectory=/opt/Mobiup/unihub-retail/backend
Environment="PATH=/opt/Mobiup/unihub-retail/backend/venv/bin:/usr/bin:/bin"
EnvironmentFile=/opt/Mobiup/unihub-retail/.env.worker
EnvironmentFile=/opt/Mobiup/ops/prometheus/unihub-retail-network.env
Environment="RETAIL_WORKER_ROLE=exports"
Environment="WORKER_METRICS_PORT=9904"
Environment=UNIHUB_DB_PROCESS_AUTHORITY=operations
ExecStart=/opt/Mobiup/unihub-retail/backend/venv/bin/python worker.py
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=2460
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=unihub-export-worker
ProtectSystem=strict
ReadWritePaths=/opt/Mobiup
ProtectHome=read-only
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0077
CPUWeight=350
IOWeight=350
MemoryLow=256M
MemoryHigh=1536M
MemoryMax=2304M
MemorySwapMax=512M

[Install]
WantedBy=multi-user.target
