[Unit]
Description=UniHub FastAPI Backend
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=andrei
WorkingDirectory=/opt/Mobiup/unihub-retail/backend
EnvironmentFile=/opt/Mobiup/unihub-retail/.env
EnvironmentFile=/opt/Mobiup/ops/prometheus/unihub-retail-network.env
Environment="UNIHUB_DB_PROCESS_AUTHORITY=web"
Environment="SESSION_VALKEY_PORT=6380"
Environment="SESSION_VALKEY_DATABASE=0"
Environment="RATE_LIMIT_VALKEY_PORT=6380"
Environment="RATE_LIMIT_VALKEY_DATABASE=1"
Environment="PROMETHEUS_MULTIPROC_DIR=/run/unihub-retail-prometheus"
Environment="PYTHONDONTWRITEBYTECODE=1"
RuntimeDirectory=unihub-retail-prometheus
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/timeout 90 /usr/bin/bash -c 'until (: >/dev/tcp/127.0.0.1/6380) 2>/dev/null; do sleep 1; done'
ExecStart=/opt/Mobiup/unihub-retail/backend/venv/bin/python3 -m uvicorn main:app --host 0.0.0.0 --port 9898 --workers 2 --no-proxy-headers
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=75
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=unihub-backend

ProtectSystem=strict
ReadWritePaths=/opt/Mobiup/unihub-retail/data/import_spool
ProtectHome=read-only
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0077
CPUWeight=800
IOWeight=800
MemoryLow=256M
MemoryHigh=768M
MemoryMax=1280M
MemorySwapMax=128M

[Install]
WantedBy=multi-user.target
