[Unit]
Description=UniHub FastAPI Backend
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=andrei
WorkingDirectory=/opt/Mobiup/unihub-retail/backend
EnvironmentFile=/opt/Mobiup/unihub-retail/.env
ExecStart=/opt/Mobiup/unihub-retail/backend/venv/bin/python3 -m uvicorn main:app --host 0.0.0.0 --port 9898 --workers 1 --no-proxy-headers
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=75
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=unihub-backend

ProtectSystem=strict
ReadWritePaths=/opt/Mobiup
ProtectHome=read-only
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
