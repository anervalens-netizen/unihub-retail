{
  "name": "unihub",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:frontend": "vite --port=3000 --host=0.0.0.0",
    "dev:backend": "cd backend && python -m uvicorn main:app --reload --host=0.0.0.0 --port=8000",
    "build": "vite build",
    "verify:rum-build": "node scripts/verify_frontend_rum_build.mjs",
    "contracts:generate": "PYTHONPATH=backend backend/venv/bin/python scripts/generate_retail_contract.py",
    "contracts:check": "PYTHONPATH=backend backend/venv/bin/python scripts/generate_retail_contract.py --check",
    "config:check": "PYTHONPATH=backend backend/venv/bin/python scripts/check_env_contract.py",
    "benchmark:exports": "PYTHONPATH=backend backend/venv/bin/python scripts/benchmark_exports.py",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled",
    "test:mutation": "backend/venv/bin/python scripts/run_targeted_mutation_tests.py",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:browsers": "playwright test --config=playwright.browser-smoke.config.ts",
    "test:e2e:pwa-real": "scripts/run_pwa_release_lifecycle.sh",
    "test:e2e:pwa-workbox": "playwright test --config=playwright.pwa-workbox.config.ts",
    "complexity:python": "python3 scripts/check_complexity_ratchet.py",
    "complexity:ts": "node scripts/check_ts_function_complexity.cjs"
  },
  "dependencies": {
    "@sentry/react": "^10.73.0",
    "@tanstack/react-query": "^5.102.8",
    "@unihub/api-client": "file:vendor/npm/unihub-api-client-0.1.0.tgz",
    "@unihub/design-tokens": "file:vendor/npm/unihub-design-tokens-0.1.0.tgz",
    "@unihub/types": "file:vendor/npm/unihub-types-0.1.0.tgz",
    "@unihub/ui-kit": "file:vendor/npm/unihub-ui-kit-0.1.0.tgz",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "web-vitals": "6.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.1",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "4.1.11",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "react-is": "^19.2.8",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.13",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
