{
  "name": "unihub",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:frontend": "vite --port=3000 --host=0.0.0.0",
    "dev:backend": "cd backend && python -m uvicorn main:app --reload --host=0.0.0.0 --port=8000",
    "build": "vite build",
    "verify:rum-build": "node scripts/verify_frontend_rum_build.mjs",
    "contracts:generate": "PYTHONPATH=backend backend/venv/bin/python scripts/generate_retail_contract.py",
    "contracts:check": "PYTHONPATH=backend backend/venv/bin/python scripts/generate_retail_contract.py --check",
    "benchmark:exports": "PYTHONPATH=backend backend/venv/bin/python scripts/benchmark_exports.py",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:browsers": "playwright test --config=playwright.browser-smoke.config.ts",
    "test:e2e:pwa-real": "playwright test --config=playwright.pwa-workbox.config.ts",
    "complexity:python": "python3 scripts/check_complexity_ratchet.py",
    "complexity:ts": "node scripts/check_ts_function_complexity.cjs"
  },
  "dependencies": {
    "@sentry/react": "^10.66.0",
    "@tanstack/react-query": "^5.101.2",
    "@unihub/api-client": "file:vendor/npm/unihub-api-client-0.1.0.tgz",
    "@unihub/design-tokens": "file:vendor/npm/unihub-design-tokens-0.1.0.tgz",
    "@unihub/types": "file:vendor/npm/unihub-types-0.1.0.tgz",
    "@unihub/ui-kit": "file:vendor/npm/unihub-ui-kit-0.1.0.tgz",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "web-vitals": "6.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.20.1",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "react-is": "^19.2.7",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
